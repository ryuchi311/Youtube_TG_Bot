{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tubesignal",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tubesignal-db",
      "migrations_dir": "migrations",
      "database_id": "648dc543-fcb3-4d51-9993-e03e2943e2be"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
