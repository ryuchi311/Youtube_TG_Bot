{
  "$schema": "node_modules/wrangler/config-schema.json",
  // wrangler.jsonc
  "name": "youtube-tg-bot",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tubesignal-db",
      "migrations_dir": "migrations",
      "database_id": "9b2fe4d9-9384-43e5-865b-ba3e46a34482"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
